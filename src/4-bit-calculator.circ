  <main name="main"/>
  <options/><mappings/><toolbar><tool lib="6" name="Poke Tool"/><tool lib="6" name="Edit Tool"/></toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <comp lib="6" loc="(320,60)" name="Text"><a name="text" val="4-BIT BINARY CALCULATOR"/><a name="font" val="SansSerif bold 22"/></comp>
    <comp lib="6" loc="(320,90)" name="Text"><a name="text" val="Click input bits with the Poke tool.  SUB: 0 = A + B, 1 = A - B"/></comp>
    <comp lib="0" loc="(140,170)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="A"/></comp>
    <comp lib="0" loc="(140,250)" name="Pin"><a name="width" val="4"/><a name="tristate" val="false"/><a name="label" val="B"/></comp>
    <comp lib="0" loc="(140,350)" name="Pin"><a name="tristate" val="false"/><a name="label" val="SUB"/></comp>
    <comp lib="0" loc="(290,350)" name="Bit Extender"><a name="in_width" val="1"/><a name="out_width" val="4"/><a name="type" val="sign"/></comp>
    <comp lib="1" loc="(380,270)" name="XOR Gate"><a name="width" val="4"/><a name="size" val="50"/><a name="inputs" val="2"/></comp>
    <comp lib="3" loc="(500,200)" name="Adder"><a name="width" val="4"/></comp>
    <comp lib="0" loc="(610,200)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="4"/><a name="label" val="RESULT"/><a name="labelloc" val="east"/></comp>
    <comp lib="1" loc="(580,300)" name="XOR Gate"><a name="size" val="50"/><a name="inputs" val="2"/></comp>
    <comp lib="0" loc="(610,300)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="CARRY_BORROW"/><a name="labelloc" val="east"/></comp>
    <comp lib="6" loc="(350,430)" name="Text"><a name="text" val="RESULT = low 4 bits.  Addition: flag = carry.  Subtraction: flag = borrow."/></comp>
    <comp lib="6" loc="(350,455)" name="Text"><a name="text" val="Examples: 0101 + 0011 = 1000; 0101 - 0011 = 0010"/></comp>
    <wire from="(140,170)" to="(430,170)"/><wire from="(430,170)" to="(430,190)"/><wire from="(430,190)" to="(460,190)"/>
